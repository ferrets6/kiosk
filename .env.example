# Copiare in .env e riempire. Nessun segreto nel repo.
# Il broker rifiuta di partire se manca una variabile obbligatoria, e le
# elenca tutte in una volta.

TZ=Europe/Rome

# --- Rete e accesso (obbligatorie) ---
# Rete da cui credere all'header forward-auth Remote-User: la rete edge.
KIOSK_TRUSTED_PROXY=172.18.0.0/16
# Segreto condiviso con Caddy (header X-Kiosk-Proxy-Secret). Senza, un
# container sulla rete edge salterebbe Caddy e l'SSO. Generare con
# `openssl rand -hex 32`. Lo stesso valore va al proxy; nell'homelab è il file
# services/caddy/config/secrets/kiosk-proxy:  header_up X-Kiosk-Proxy-Secret <valore>
KIOSK_PROXY_SECRET=

# --- Docker ---
# Il docker-socket-proxy (mai il socket nudo: sarebbe root sull'host).
KIOSK_DOCKER_HOST=http://kiosk-socket-proxy:2375
# Immagine iniziale del browser, PINNATA PER DIGEST (obbligatoria). Poi si
# cambia da /admin.
KIOSK_BROWSER_IMAGE=lscr.io/linuxserver/chromium@sha256:
# Rete su cui nascono i browser (il broker li raggiunge per nome).
KIOSK_NETWORK=edge

# --- Download (obbligatoria) ---
# Percorso SULL'HOST. I download finiscono in <base>/<utente>. Va montato nel
# broker allo STESSO percorso: il broker crea lì la cartella dell'utente.
KIOSK_STAGING_BASE=/tank/media/staging/zlatan
# Pagina che il browser apre all'avvio.
KIOSK_START_URL=https://takeout.google.com/

# --- Default (poi modificabili da /admin, anche per utente) ---
# Un browser è distrutto quando valgono ENTRAMBI: nessun viewer da
# KIOSK_VIEWER_IDLE e nessun download mosso da KIOSK_DOWNLOAD_STALE (max 24h).
KIOSK_VIEWER_IDLE=15m
KIOSK_DOWNLOAD_STALE=10m
# RAM massima di ogni browser, MB (0 = nessun limite).
KIOSK_BROWSER_MEMORY_MB=2048

# --- Server ---
KIOSK_ADDR=:8080
# state.json: immagine scelta dall'admin, default, override, ultimo uso.
KIOSK_DATA_DIR=/data
